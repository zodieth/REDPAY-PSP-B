{
  "name": "redpagos",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/db",
    "packages/cargavirtual",
    "packages/core",
    "apps/*"
  ],
  "scripts": {
    "api": "node --env-file-if-exists=.env apps/api/src/index.ts",
    "worker": "node --env-file-if-exists=.env apps/worker/src/index.ts",
    "migrar": "node --env-file-if-exists=.env packages/db/src/migrar.ts",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"packages/*/test/*.test.ts\" \"test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "^18.4.0-beta.17",
    "typescript": "^5.9.0"
  }
}
