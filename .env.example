# Postgres (docker compose up -d levanta uno en el 5433)
DATABASE_URL=postgres://redpagos:redpagos@localhost:5433/redpagos

# Cifra las claves de cargavirtual guardadas en la DB. Si se pierde, hay que recargarlas.
CLAVE_CIFRADO=

# Header x-admin-key para /admin/* (backoffice)
ADMIN_API_KEY=

PORT=3000

# Panel (apps/panel, puerto 3001)
# Firma las cookies de sesión: al menos 32 caracteres al azar.
SESION_SECRETO=
# Primer admin: se crea al arrancar el panel si todavía no hay ninguno.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Proxy con IP argentina para cargavirtual (no acepta conexiones de afuera)
# CARGAVIRTUAL_PROXY=http://usuario:clave@host:puerto

# Worker
# CONSULTAS_EN_PARALELO=8
# POLL_ASIGNADO_SEG=60
# POLL_CUARENTENA_SEG=600
# POLL_LIBRE_SEG=3600
# ALERTA_POOL_PORCENTAJE=80
